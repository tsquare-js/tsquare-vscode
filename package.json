{
  "name": "tsquare-vscode",
  "displayName": "tsquare",
  "description": "Write tsquare UI wireframes with a live preview, problems as you type, highlighting and autocomplete.",
  "version": "0.2.0",
  "publisher": "tsquare-js",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#032D7B",
    "theme": "dark"
  },
  "preview": true,
  "pricing": "Free",
  "keywords": [
    "tsquare",
    "tsq",
    "wireframe",
    "wireframes",
    "mockup",
    "mockups",
    "ui",
    "ux",
    "prototype",
    "screens",
    "diagram",
    "design",
    "sketch",
    "ai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tsquare-js/tsquare-vscode"
  },
  "bugs": {
    "url": "https://github.com/tsquare-js/tsquare-vscode/issues"
  },
  "homepage": "https://tsquare.dev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:tsquare.preview"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "vscode:prepublish": "node build.mjs --production",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc -p .",
    "test:grammar": "node test/grammar.mjs",
    "test:vscode": "npm run build && node test/run.mjs",
    "test:vsix": "node test/vsix.mjs",
    "test": "npm run typecheck && npm run test:grammar && npm run test:vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "tsquare",
        "aliases": [
          "tsquare"
        ],
        "extensions": [
          ".tsq"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/tsquare.svg",
          "dark": "./media/tsquare.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tsquare",
        "scopeName": "source.tsquare",
        "path": "./syntaxes/tsquare.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tsquare.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "tsquare",
        "icon": "$(open-preview)"
      },
      {
        "command": "tsquare.showPreview",
        "title": "Open Preview",
        "category": "tsquare",
        "icon": "$(open-preview)"
      },
      {
        "command": "tsquare.showSource",
        "title": "Show Source",
        "category": "tsquare",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tsquare.copyImageLink",
        "title": "Copy Image Link",
        "category": "tsquare",
        "icon": "$(link)"
      },
      {
        "command": "tsquare.openInPlayground",
        "title": "Open in Playground",
        "category": "tsquare"
      },
      {
        "command": "tsquare.exportSvg",
        "title": "Export SVG…",
        "category": "tsquare"
      },
      {
        "command": "tsquare.fit",
        "title": "Fit to Window",
        "category": "tsquare"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tsquare.showPreviewToSide",
          "when": "editorLangId == tsquare",
          "group": "navigation"
        },
        {
          "command": "tsquare.showSource",
          "when": "activeWebviewPanelId == tsquare.preview",
          "group": "navigation"
        },
        {
          "command": "tsquare.copyImageLink",
          "when": "activeWebviewPanelId == tsquare.preview",
          "group": "1_tsquare@1"
        },
        {
          "command": "tsquare.openInPlayground",
          "when": "activeWebviewPanelId == tsquare.preview",
          "group": "1_tsquare@2"
        },
        {
          "command": "tsquare.exportSvg",
          "when": "activeWebviewPanelId == tsquare.preview",
          "group": "2_export@1"
        }
      ],
      "explorer/context": [
        {
          "command": "tsquare.showPreview",
          "when": "resourceExtname == .tsq",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tsquare.showPreviewToSide",
          "when": "editorLangId == tsquare"
        },
        {
          "command": "tsquare.showPreview",
          "when": "editorLangId == tsquare"
        },
        {
          "command": "tsquare.showSource",
          "when": "activeWebviewPanelId == tsquare.preview"
        },
        {
          "command": "tsquare.copyImageLink",
          "when": "editorLangId == tsquare || activeWebviewPanelId == tsquare.preview"
        },
        {
          "command": "tsquare.openInPlayground",
          "when": "editorLangId == tsquare || activeWebviewPanelId == tsquare.preview"
        },
        {
          "command": "tsquare.exportSvg",
          "when": "editorLangId == tsquare || activeWebviewPanelId == tsquare.preview"
        },
        {
          "command": "tsquare.fit",
          "when": "activeWebviewPanelId == tsquare.preview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tsquare.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == tsquare"
      },
      {
        "command": "tsquare.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == tsquare"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.2",
    "tsquare": "0.13.2",
    "typescript": "^5.9.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
